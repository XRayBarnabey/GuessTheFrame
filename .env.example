# GuessTheFrame - local development configuration
# Copy this file to .env (scripts/setup.ps1 does it automatically).
# Never commit .env.

GTF_ENV=development
GTF_HOST=127.0.0.1
GTF_PORT=5274
GTF_FRONTEND_URL=http://localhost:5174
GTF_HTTP_PORT=8000
TZ=Europe/Paris

# SQLite for local development. PostgreSQL example:
# GTF_DATABASE_URL=postgresql+asyncpg://guesstheframe:password@localhost:5432/guesstheframe
GTF_DATABASE_URL=sqlite+aiosqlite:///./data/guessTheFrame.db

# Generated by scripts/setup.ps1 if left as "change-me" / empty.
GTF_ENCRYPTION_KEY=change-me
GTF_SETUP_TOKEN=change-me

# Emby accounts promoted to GuessTheFrame administrators (comma separated).
GTF_ADMIN_EMBY_USERNAMES=admin

# Session cookies. Set to true only behind HTTPS.
GTF_SESSION_COOKIE_SECURE=false
GTF_SESSION_IDLE_DAYS=7
GTF_SESSION_ABSOLUTE_DAYS=30

# Frame cache.
GTF_FRAME_CACHE_DIR=./data/frames
GTF_FRAME_CACHE_MAX_MB=2048
GTF_FFMPEG_PATH=
GTF_FFMPEG_TIMEOUT_SECONDS=30
GTF_FFMPEG_CONCURRENCY=2

# Initial Emby server address, used to prefill the setup screen.
GTF_EMBY_URL=http://192.168.1.50:8096
GTF_EMBY_VERIFY_TLS=true

GTF_LOG_LEVEL=INFO

# Docker production only: password for the PostgreSQL container.
# Generate a long random value and keep it secret.
POSTGRES_PASSWORD=change-me

# Public URL used by the container (behind your TLS reverse proxy).
GTF_PUBLIC_URL=http://localhost:8000
